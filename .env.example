# Copy this file to .env.local before running npm run dev.
# Do not commit .env.local to GitHub.

# Optional: used by src/app/api/ai/route.ts for AI summary generation.

ANTHROPIC_API_KEY= your_anthropic_api_key

# Required: used by src/lib/supabase.ts to connect to Supabase.
NEXT_PUBLIC_SUPABASE_URL= your_supabase_url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY= your_supabase_anon_key


# Alternative public key name. Use this instead of NEXT_PUBLIC_SUPABASE_ANON_KEY if Supabase shows Publishable key.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
