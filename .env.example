# HyperSense — Environment Variables
# คัดลอกไฟล์นี้เป็น .env.local สำหรับ local development
# ตั้งค่าเหล่านี้ใน Cloudflare Pages → Settings → Environment variables

# ── Supabase ──────────────────────────────────────────────────────────────────
# Project URL จาก Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Anon key (public) — ใช้ได้ฝั่ง client
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# หรือถ้า Supabase แสดงเป็น Publishable key ให้ใช้ชื่อนี้แทน
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
